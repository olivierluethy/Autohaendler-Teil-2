@model IEnumerable<Auto>
@{
    ViewData["Title"] = "Index";
    var ifempty = 0;
    @foreach(var obj in Model)
    {
        ifempty++;
    }
}

<div class="container p-3">
    <div class="row pt-4">
        <div class="col-6">
            <h2 class="text-primary">Autoverkaufsliste</h2>
        </div>
        <div class="col-6 text-end">
            <a asp-controller="Auto" asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> &nbsp; Neues Auto erfassen
            </a>
        </div>
    </div>

    @if (ifempty == 0)
    {
        <h1>Keine Autos gefunden</h1>
    }else{
        <form asp-controller="Auto" asp-action="Index" method="get">
            <div class="input-group md-form form-sm formcol-2 pl-0">
                <input name="modelName" class=" form-control my-0 py-1 red-border" type="text" placeholder="Search">
                <div class="input-group-append">
                    <button type="submit" class="input-group-text red lighten-3" id="basic-text1">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
            </div>
        </form>

        <table class="table table-bordered table-striped" style="width:100%">
    <thead>
        <tr>
            <th>
                Id
            </th>
            <th>
                Modell
            </th>
            <th>
                Hersteller
            </th>
            <th>
                Farbe
            </th>
            <th>
                Preis
            </th>
            <th>
                Bearbeiten
            </th>
            <th>
                Löschen
            </th>
        </tr>
    </thead>
    <tbody> 
             @foreach(var obj in Model)
             {
            <tr>
                <td width="10%">
                    @obj.Id                
                </td>
                <td width="15%">
                    @obj.Modell           
                </td>
                <td width="30%">
                    @obj.Hersteller         
                </td>
                <td width="10%">
                    @obj.Farbe         
                </td>
                <td width="5%">
                    @obj.Preis       
                </td>
                <td width="10%">
                    <div class="w-75 btn-group" role="group">
                        <a asp-controller="Auto" asp-action="Edit" asp-route-id="@obj.Id" 
                        class="btn btn-primary mx-2"> <i class="bi bi-pencil-square"></i> Edit</a>
                    </div>          
                </td>
                <td width="12%">
                    <div class="w-75 btn-group" role="group">
                        <a asp-controller="Auto" asp-action="Delete" asp-route-id="@obj.Id" 
                        class="btn btn-primary mx-2"> <i class="bi bi-trash-fill"></i> Delete</a>
                    </div>          
                </td>
            </tr>   
            }
    </tbody>
</table>
}
</div>