@model Autoverkaeufe

<form method="post" asp-action="Delete">
    <div class="border p-3 mt-4">
        <div class="row pb-2">
            <h2 class="text-primary">Autoverkauf löschen</h2>
            <hr />
        </div>
        <div class="mb-3">
            <label asp-for="Datum"></label>
            <input type="date" asp-for="Datum" class="form-control" readonly/>
        </div>
        <div class="mb-3">
            <label asp-for="Anzahl"></label>
            <input type="number" asp-for="Anzahl" class="form-control" readonly/>
        </div>
        <div class="mb-3">
            <label asp-for="Preis"></label>
            <input type="number" asp-for="Preis" class="form-control" readonly/>
        </div>
        <button type="submit" class="btn btn-danger" style="width:150px">Delete</button>
        <a asp-controller="Autoverkaeufe" asp-action="Index" class="btn btn-secondary" style="width:150px">
            Back to List
        </a>
    </div>
</form>