@model Autoverkaeufe

<form method="post">
    <div class="border p-3 mt-4">
        <div class="row pb-2">
            <h2 class="text-primary">Autoverkauf erfassen</h2>
            <hr />
        </div>
        <div class="mb-3">
            <label asp-for="Datum"></label>
            <input type="date" asp-for="Datum" class="form-control"/>
            <span asp-validation-for="Datum" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Anzahl"></label>
            <input type="number" asp-for="Anzahl" class="form-control"/>
            <span asp-validation-for="Anzahl" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Preis"></label>
            <input type="number" asp-for="Preis" class="form-control"/>
            <span asp-validation-for="Preis" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary" style="width:150px">Create</button>
        <a asp-controller="Autoverkaeufe" asp-action="Index" class="btn btn-secondary" style="width:150px">
            Back to List
        </a>
    </div>
</form>

@section Scripts{
    @{
        <partial name="_ValidationScriptsPartial"/>
    }
}