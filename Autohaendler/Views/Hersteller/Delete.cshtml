@model Hersteller

<form method="post" asp-action="Delete">
    <div class="border p-3 mt-4">
        <div class="row pb-2">
            <h2 class="text-primary">Hersteller löschen</h2>
            <hr />
        </div>
        <div class="mb-3">
            <label asp-for="Name"></label>
            <input type="text" asp-for="Name" class="form-control" readonly/>
        </div>
        <div class="mb-3">
            <label asp-for="Adresse"></label>
            <input type="text" asp-for="Adresse" class="form-control" readonly/>
        </div>
        <div class="mb-3">
            <label asp-for="Telefonnummer"></label>
            <input type="text" asp-for="Telefonnummer" class="form-control" readonly/>
        </div>
        <button type="submit" class="btn btn-danger" style="width:150px">Delete</button>
        <a asp-controller="Hersteller" asp-action="Index" class="btn btn-secondary" style="width:150px">
            Back to List
        </a>
    </div>
</form>