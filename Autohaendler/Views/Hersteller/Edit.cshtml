@model Hersteller

<form method="post" asp-action="Edit">
    <div class="border p-3 mt-4">
        <div class="row pb-2">
            <h2 class="text-primary">Hersteller bearbeiten</h2>
            <hr />
        </div>
        <div class="mb-3">
            <label asp-for="Name"></label>
            <input type="text" asp-for="Name" class="form-control"/>
        </div>
        <div class="mb-3">
            <label asp-for="Adresse"></label>
            <input type="text" asp-for="Adresse" class="form-control"/>
        </div>
        <div class="mb-3">
            <label asp-for="Telefonnummer"></label>
            <input type="text" asp-for="Telefonnummer" class="form-control"/>
        </div>
        <button type="submit" class="btn btn-primary" style="width:150px">Edit</button>
        <a asp-controller="Hersteler" asp-action="Index" class="btn btn-secondary" style="width:150px">
            Back to List
        </a>
    </div>
</form>

@section Scripts{
    @{
        <partial name="_ValidationScriptsPartial"/>
    }
}